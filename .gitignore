# Python
__pycache__/
*.py[cod]
*$py.class

# Virtual environment
venv/
.env/

# Jupyter
.ipynb_checkpoints/

# OS
.DS_Store
Thumbs.db

# Model files
*.pkl
*.joblib

# Temporary files
*.tmp

# Logs
*.log

# Results
# Ignore generated results by default
results/**

# Keep reproducible numerical results
!results/comparison/
!results/comparison/*.csv

# Keep model parameters
!results/**/best_params.json

# Keep predictions
!results/**/predictions.csv

# Keep SHAP numerical results
!results/**/mean_abs_shap.tsv
!results/**/training_shap.tsv
!results/**/testing_shap.tsv

# Ignore generated visualizations
results/**/*.png

# Keep README example figures
!results/examples/
!results/examples/**

# Generated feature files (ECFP / descriptors tsv)
# 這些檔案是 run_pipeline.py 自動產生的，可以重新跑出來，不需要進版控
data/features/*
!data/features/.gitkeep

# 如果原始資料集也不想上 GitHub（例如授權/隱私考量），取消下面兩行的註解：
# data/raw/*
# !data/raw/.gitkeep
# Editor config (personal, shouldn't be shared)
.vscode/
